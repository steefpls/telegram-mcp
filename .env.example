# Telegram API Credentials (Required - get from https://my.telegram.org/apps)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Session Management (Choose ONE)
# Option 1: File-based session (a .session file will be created)
TELEGRAM_SESSION_NAME=telegram_session
# Option 2: String-based session (if you generate one, e.g., using Telethon's string session generator)
TELEGRAM_SESSION_STRING=1231231232erfdfdffd

# ---------------------------------------------------------------------------
# Optional: @claude trigger
# ---------------------------------------------------------------------------
# Off by default. When enabled, telegram-mcp watches incoming messages for
# "@claude" mentions and spawns headless Claude Code with chat history as
# context, replying in-chat by editing a "thinking" ack message in place.
#
# When enabled, telegram-mcp also exposes its tools over HTTP (in addition
# to stdio) so the spawned Claude can read/send messages on your behalf.
# CLAUDE_TRIGGER_ENABLED=true
# OWNER_USER_ID=                 # required: your Telegram user_id (call get_me to find it)
# MCP_API_KEY=                   # required: any random secret (no slashes/spaces) — path-segment auth for HTTP transport
# MCP_PORT=8081                  # HTTP transport bind port (must not collide with whatsapp-mcp's 8080)
# CLAUDE_PATH=claude             # path to the claude CLI binary
# CLAUDE_MODEL=                  # leave empty for default; or "opus", "sonnet", "haiku"
# CLAUDE_MAX_BUDGET_USD=1.00     # max spend per @claude turn
# CLAUDE_TIMEOUT_SECONDS=300     # subprocess timeout
# CLAUDE_HISTORY_MESSAGES=40     # how many recent messages to embed in the prompt
# MEMORY_VAULT=                  # if set (e.g. "work"), spawned Claude is told to silently search memory-index for context
#
# --- Persistence (SQLite) ---
# CLAUDE_TRIGGER_DB_PATH=data/telegram_mcp.db
# CLAUDE_SESSION_TTL_HOURS=24    # how long a per-chat resume session stays valid
#
# --- Compaction (auto-summarize before context window fills) ---
# CLAUDE_COMPACT_THRESHOLD_TOKENS=120000   # when last_input_tokens >= this, compact before next turn
# CLAUDE_COMPACT_MODEL=haiku               # cheap model for the summarization pass
# CLAUDE_COMPACT_TIMEOUT_SECONDS=180       # subprocess timeout for the summarization call
# CLAUDE_COMPACT_MAX_BUDGET_USD=0.50       # budget cap for the summarization call
#
# --- Media auto-download ---
# Background downloads of incoming media so the spawned Claude can read images,
# voice notes, documents, etc. via the `tg://media/{chat_id}/{message_id}`
# MCP resource. Files land under MEDIA_DOWNLOAD_DIR/{yyyy}/{mm}/{dd}/.
# MEDIA_AUTO_DOWNLOAD_ENABLED=true                              # default true when trigger is on
# MEDIA_AUTO_DOWNLOAD_MAX_SIZE_MB=20                            # skip larger attachments
# MEDIA_AUTO_DOWNLOAD_TYPES=photo,voice,audio,video,video_note,gif,document  # csv; remove `sticker` to keep noise down
# MEDIA_DOWNLOAD_DIR=data/media
# MEDIA_WAIT_TIMEOUT_SECONDS=10                                 # how long the trigger waits for in-flight downloads before building the prompt
